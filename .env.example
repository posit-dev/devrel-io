# GitHub Personal Access Token
# Used by velocirepo to fetch GitHub events and traffic data
GITHUB_TOKEN=your_github_token_here

# Plausible Analytics API Key
# Used by velocirepo to fetch website analytics
PLAUSIBLE_TOKEN=your_plausible_api_key_here

# AWS Bedrock Configuration
# Used by chat.py for ChatBedrockAnthropic client
# Option 1: Use AWS SSO profile (recommended)
AWS_PROFILE=posit

# Option 2: Use explicit credentials
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS region for Bedrock (defaults to us-east-2)
AWS_REGION=us-east-2

# Bedrock model ID (defaults to Claude Sonnet 4.5 via US inference profile)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
