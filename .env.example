# GitHub Personal Access Token
# Used by fetch_github.py to fetch GitHub events data
# See README.md for instructions on how to create a token
GITHUB_TOKEN=your_github_token_here

# Plausible Analytics API Key
# Used by fetch_plausible.py to fetch website analytics
# Get from Plausible Settings → API Keys
PLAUSIBLE_KEY=your_plausible_api_key_here

# AWS Bedrock Configuration
# Used by chat.py for ChatBedrockAnthropic client
# Option 1: Use AWS SSO profile (recommended)
AWS_PROFILE=posit

# Option 2: Use explicit credentials
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS region for Bedrock (defaults to us-east-2)
AWS_REGION=us-east-2

# Bedrock model ID (defaults to Claude Sonnet 4.5 via US inference profile)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
